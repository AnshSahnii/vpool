# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key

# Database (MySQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=mysql+pymysql://vpool_user:vpool_pass@localhost:3306/vpool_db

# Fallback local dev DB (SQLite) - used automatically if DATABASE_URL is not reachable
SQLITE_FALLBACK=sqlite:///vpool_dev.db
USE_SQLITE=false

# Geolocation / Maps
# Get a free key at https://locationiq.com or use OpenStreetMap Nominatim (no key required)
GEOCODING_PROVIDER=nominatim
LOCATIONIQ_API_KEY=

# Mail (for forgot password - optional, console fallback used if not set)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
